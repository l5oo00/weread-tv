{
  "manifest_version": 2,
  "name": "weread-tv-shell",
  "version": "2.9",
  "description": "WeReadTV 页面适配层：焦点导航 / 自由光标 / 四向滚动 / 命中定位。由 background 用 contentScripts.register 注入外部 tv.js。",
  "background": {
    "scripts": [
      "bg.js"
    ],
    "persistent": true
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "*://weread.qq.com/*",
    "*://*.weread.qq.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "weread-tv@shell.local"
    }
  }
}
